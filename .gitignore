# ===== 编译产物 / 二进制 =====
# Makefile 里 go build -o webook . 生成的可执行文件，Docker 打包时再构建
/webook
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go 编译与测试产物
*.test
*.out
*.prof

# ===== 依赖与工作区 =====
# 依赖走 go.mod / go.sum，vendor 一般不入库（要用 vendor 时把下面这行删掉）
/vendor/
go.work
go.work.sum

# ===== 本地工具目录 =====
# WorkBuddy / 编辑器生成的本地数据，和项目源码无关
.workbuddy/
.codebuddy/

# ===== IDE / 编辑器 =====
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ===== 系统文件 =====
.DS_Store
._*
Thumbs.db

# ===== 日志与临时文件 =====
*.log
logs/
tmp/
*.local
*.env
.env
